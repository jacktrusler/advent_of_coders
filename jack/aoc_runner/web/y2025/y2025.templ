package y2025

import "aoc/web/components"

templ y2025(title string) {
	@components.HtmlWrapper(title) {
		<div class="font-ibm-plex-mono">
			<div class="section-header">
				<div class="title">Advent of Code 2025</div>
				<div class="day-title">Day 1: Break the Lock</div>
			</div>
			@day01()
			<div class="section-header">
				<div class="day-title">Day 2: Duplicate Disaster</div>
			</div>
			@day02()
			<div class="section-header">
				<div class="day-title">Day 3: Bankin' and Clankin'</div>
			</div>
			@day03()
			<div class="section-header">
				<div class="day-title">Day 4: Printing Department</div>
			</div>
			@day04()
			<div class="section-header">
				<div class="day-title">Day 5: Cafeteria</div>
			</div>
			@day05()
			<div class="section-header">
				<div class="day-title">Day 6: Trash Compactor</div>
			</div>
			@day06()
			<div class="section-header">
				<div class="day-title">Day 7: Laboratories</div>
			</div>
			@day07()
			<div class="section-header">
				<div class="day-title">Day 8: Playground</div>
			</div>
			@day08()
			<div class="section-header">
				<div class="day-title">Day 9: Laboratories</div>
			</div>
			@day09()
			<div class="section-header">
				<div class="day-title">Day 10: Laboratories</div>
			</div>
			@day10()
			<div class="section-header">
				<div class="day-title">Day 11: Laboratories</div>
			</div>
			@day11()
			<div class="section-header">
				<div class="day-title">Day 12: Laboratories</div>
			</div>
			@day12()
		</div>
		@components.Footer()
	}
}
