package y2025

templ day08() {
	<section id="day08">
		<div class="button-container">
			<div class="text-center">
				<div class="part-title">Both Parts</div>
				<button
					data-on:click="@get('/year/2025/day/8')"
				>
					Calculate
				</button>
			</div>
			@BothPartsD8(0, 0)
		</div>
	</section>
}

templ BothPartsD8(ans1, ans2 int) {
	<div id="day08ans">
		<div>{ ans1 }</div>
		<div>{ ans2 }</div>
	</div>
}
