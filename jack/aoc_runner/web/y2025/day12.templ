package y2025

templ day12() {
	<section id="day12">
		<div class="button-container">
			<div class="text-center">
				<div class="part-title">Both Parts</div>
				<button
					data-on:click="@get('/year/2025/day/12')"
				>
					Calculate
				</button>
			</div>
			@BothPartsD12(0, 0)
		</div>
	</section>
}

templ BothPartsD12(ans1, ans2 int) {
	<div id="day12ans">
		<div>{ ans1 }</div>
		<div>{ ans2 }</div>
	</div>
}
