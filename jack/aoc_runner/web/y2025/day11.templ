package y2025

templ day11() {
	<section id="day11">
		<div class="button-container">
			<div class="text-center">
				<div class="part-title">Both Parts</div>
				<button
					data-on:click="@get('/year/2025/day/11')"
				>
					Calculate
				</button>
			</div>
			@BothPartsD11(0, 0)
		</div>
	</section>
}

templ BothPartsD11(ans1, ans2 int) {
	<div id="day11ans">
		<div>{ ans1 }</div>
		<div>{ ans2 }</div>
	</div>
}
