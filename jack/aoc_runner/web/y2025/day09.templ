package y2025

templ day09() {
	<section id="day09">
		<div class="button-container">
			<div class="text-center">
				<div class="part-title">Both Parts</div>
				<button
					data-on:click="@get('/year/2025/day/9')"
				>
					Calculate
				</button>
			</div>
			@BothPartsD9(0, 0)
		</div>
	</section>
}

templ BothPartsD9(ans1, ans2 int) {
	<div id="day09ans">
		<div>{ ans1 }</div>
		<div>{ ans2 }</div>
	</div>
}
