package y2025

templ day10() {
	<section id="day10">
		<div class="button-container">
			<div class="text-center">
				<div class="part-title">Both Parts</div>
				<button
					data-on:click="@get('/year/2025/day/10')"
				>
					Calculate
				</button>
			</div>
			@BothPartsD10(0, 0)
		</div>
	</section>
}

templ BothPartsD10(ans1, ans2 int) {
	<div id="day10ans">
		<div>{ ans1 }</div>
		<div>{ ans2 }</div>
	</div>
}
