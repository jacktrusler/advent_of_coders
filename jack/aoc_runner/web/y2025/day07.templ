package y2025

templ day07() {
	<section id="day07">
		<div class="button-container">
			<div class="text-center">
				<div class="part-title">Both Parts</div>
				<button
					data-on:click="@get('/year/2025/day/7')"
				>
					Calculate
				</button>
			</div>
			@BothPartsD7(0, 0)
		</div>
	</section>
}

templ BothPartsD7(ans1, ans2 int) {
	<div id="day07ans">
		<div>{ ans1 }</div>
		<div>{ ans2 }</div>
	</div>
}
